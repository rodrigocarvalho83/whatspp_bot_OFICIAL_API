            "data": "{\"sql\": \"\\nSELECT\\n  COALESCE(e.LAT, c.LAT) AS LAT,\\n  COALESCE(e.LON, c.LON) AS LON,\\n  COALESCE(d.ENDERECO, e.LOGRADOURO, c.ENDERECO, 'SEM RUA') AS RUA,\\n  COALESCE(d.BAIRRO, e.BAIRRO, c.BAIRRO, 'SEM BAIRRO') AS BAIRRO,\\n  COUNT(p.CODIGO) AS PEDIDOS,\\n  COUNT(DISTINCT p.CODIGOCONTATOCLIENTE) AS CLIENTES,\\n  SUM(p.VALORTOTAL - p.VALORENTREGA) AS RECEITA_PIZZARIA,\\n  AVG(p.VALORTOTAL - p.VALORENTREGA) AS TICKET_MEDIO\\nFROM PEDIDOS p\\nINNER JOIN CONTATOS c ON c.CODIGO = p.CODIGOCONTATOCLIENTE\\nLEFT JOIN DELIVERY d ON d.CODIGOPEDIDO = p.CODIGO\\nLEFT JOIN ENDERECO e ON e.CODIGO = d.CODIGOENDERECO\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\n  AND COALESCE(e.LAT, c.LAT) IS NOT NULL\\n  AND COALESCE(e.LON, c.LON) IS NOT NULL\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\nGROUP BY\\n  COALESCE(e.LAT, c.LAT),\\n  COALESCE(e.LON, c.LON),\\n  COALESCE(d.ENDERECO, e.LOGRADOURO, c.ENDERECO, 'SEM RUA'),\\n  COALESCE(d.BAIRRO, e.BAIRRO, c.BAIRRO, 'SEM BAIRRO')\\nORDER BY PEDIDOS DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
