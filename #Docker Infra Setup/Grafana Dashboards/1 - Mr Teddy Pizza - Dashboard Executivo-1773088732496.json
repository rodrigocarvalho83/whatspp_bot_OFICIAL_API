            "data": "{\"sql\": \"\\nSELECT\\n  po.DESCRICAO AS ORIGEM,\\n  COUNT(*) AS PEDIDOS,\\n  SUM(p.VALORTOTAL - p.VALORENTREGA) AS FATURAMENTO\\nFROM PEDIDOS p\\nLEFT JOIN PEDIDOORIGEM po ON po.CODIGO = p.CODIGOPEDIDOORIGEM\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\nGROUP BY po.DESCRICAO\\nORDER BY FATURAMENTO DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
