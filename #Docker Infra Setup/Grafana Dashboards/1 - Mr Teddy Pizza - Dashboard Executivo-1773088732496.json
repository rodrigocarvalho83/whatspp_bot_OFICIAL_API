            "data": "{\"sql\": \"\\nWITH PRIMEIRO_PEDIDO AS (\\n  SELECT CODIGOCONTATOCLIENTE, MIN(DATAFECHAMENTO) PRIMEIRO_PEDIDO\\n  FROM PEDIDOS\\n  WHERE DATADELETE IS NULL\\n    AND DATAFECHAMENTO IS NOT NULL\\n    AND CODIGOCONTATOCLIENTE IS NOT NULL\\n  GROUP BY CODIGOCONTATOCLIENTE\\n)\\nSELECT\\n  EXTRACT(YEAR FROM p.DATAFECHAMENTO) || '-' || RIGHT('00' || EXTRACT(MONTH FROM p.DATAFECHAMENTO), 2) AS MES,\\n  CASE\\n    WHEN DATEDIFF(MONTH FROM pp.PRIMEIRO_PEDIDO TO p.DATAFECHAMENTO) < 2 THEN 'Novo'\\n    WHEN DATEDIFF(MONTH FROM pp.PRIMEIRO_PEDIDO TO p.DATAFECHAMENTO) < 6 THEN 'Curto Prazo'\\n    WHEN DATEDIFF(MONTH FROM pp.PRIMEIRO_PEDIDO TO p.DATAFECHAMENTO) < 12 THEN 'Médio Prazo'\\n    ELSE 'Antigo'\\n  END AS SEGMENTO,\\n  COUNT(DISTINCT p.CODIGOCONTATOCLIENTE) AS CLIENTES\\nFROM PEDIDOS p\\nJOIN PRIMEIRO_PEDIDO pp ON pp.CODIGOCONTATOCLIENTE = p.CODIGOCONTATOCLIENTE\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\nGROUP BY 1, 2\\nORDER BY MES, SEGMENTO\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
