          "url": "https://vm-api.mrteddypizza.com.br/query/select",
          "url_options": {
            "body_content_type": "application/json",
            "body_type": "raw",
            "data": "{\"sql\": \"\\nSELECT\\n  CAST(p.DATAFECHAMENTO AS DATE) AS DIA,\\n  c.NOME AS MOTOBOY,\\n  SUM(COALESCE(d.FRETE, 0)) AS GASTO_MOTOBOY\\nFROM PEDIDOS p\\nINNER JOIN DELIVERY d ON d.CODIGOPEDIDO = p.CODIGO\\nINNER JOIN CONTATOS c ON c.CODIGO = p.CODIGOCOLABORADOR\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\n  AND COALESCE(d.FRETE, 0) > 0\\nGROUP BY CAST(p.DATAFECHAMENTO AS DATE), c.NOME\\nORDER BY DIA DESC, GASTO_MOTOBOY DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST"
          }
        }
      ],
      "title": "Gastos com Motoboys por Dia",
