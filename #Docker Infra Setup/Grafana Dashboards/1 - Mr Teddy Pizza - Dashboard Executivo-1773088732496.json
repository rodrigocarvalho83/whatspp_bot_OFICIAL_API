            "data": "{\"sql\": \"\\nWITH PEDIDOS_CLIENTE AS (\\n  SELECT\\n    CODIGOCONTATOCLIENTE,\\n    DATAFECHAMENTO,\\n    LAG(DATAFECHAMENTO) OVER (PARTITION BY CODIGOCONTATOCLIENTE ORDER BY DATAFECHAMENTO) AS PEDIDO_ANTERIOR\\n  FROM PEDIDOS\\n  WHERE DATADELETE IS NULL\\n    AND DATAFECHAMENTO IS NOT NULL\\n    AND CODIGOCONTATOCLIENTE IS NOT NULL\\n)\\nSELECT\\n  EXTRACT(YEAR FROM DATAFECHAMENTO) || '-' || RIGHT('00' || EXTRACT(MONTH FROM DATAFECHAMENTO), 2) AS MES,\\n  COUNT(*) AS CLIENTES_REATIVADOS\\nFROM PEDIDOS_CLIENTE\\nWHERE PEDIDO_ANTERIOR IS NOT NULL\\n  AND DATEDIFF(DAY FROM PEDIDO_ANTERIOR TO DATAFECHAMENTO) >= 90\\n  AND DATAFECHAMENTO >= ?\\n  AND DATAFECHAMENTO < ?\\nGROUP BY 1\\nORDER BY MES\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
