          "url": "https://vm-api.mrteddypizza.com.br/query/select",
          "url_options": {
            "body_content_type": "application/json",
            "body_type": "raw",
            "data": "{\"sql\": \"SELECT\\n  TIPO_INCENTIVO,\\n  COUNT(*) AS PEDIDOS,\\n  SUM(VALORTOTAL) AS FATURAMENTO_BRUTO,\\n  SUM(VALORTOTAL - VALORENTREGA) AS RECEITA_PIZZARIA\\nFROM (\\n  SELECT\\n    p.CODIGO,\\n    p.VALORTOTAL,\\n    p.VALORENTREGA,\\n    CASE\\n      WHEN p.CODIGOCUPOM IS NOT NULL AND EXISTS (\\n        SELECT 1\\n        FROM ITENSPEDIDO ip2\\n        INNER JOIN ITEMPEDIDOPROMOCAO ipp2 ON ipp2.CODIGOPROITEMPEDIDO = ip2.CODIGO\\n        WHERE ip2.CODIGOPEDIDO = p.CODIGO\\n          AND ip2.DATADELETE IS NULL\\n      ) THEN 'CUPOM + PROMOÇÃO'\\n      WHEN p.CODIGOCUPOM IS NOT NULL THEN 'SOMENTE CUPOM'\\n      WHEN EXISTS (\\n        SELECT 1\\n        FROM ITENSPEDIDO ip3\\n        INNER JOIN ITEMPEDIDOPROMOCAO ipp3 ON ipp3.CODIGOPROITEMPEDIDO = ip3.CODIGO\\n        WHERE ip3.CODIGOPEDIDO = p.CODIGO\\n          AND ip3.DATADELETE IS NULL\\n      ) THEN 'SOMENTE PROMOÇÃO'\\n      ELSE 'SEM INCENTIVO'\\n    END AS TIPO_INCENTIVO\\n  FROM PEDIDOS p\\n  WHERE p.DATADELETE IS NULL\\n    AND p.DATAFECHAMENTO IS NOT NULL\\n    AND p.DATAFECHAMENTO >= ?\\n    AND p.DATAFECHAMENTO < ?\\n) BASE\\nGROUP BY TIPO_INCENTIVO\\nORDER BY FATURAMENTO_BRUTO DESC\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
