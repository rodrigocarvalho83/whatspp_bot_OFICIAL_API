            "data": "{\"sql\": \"SELECT FIRST 20\\n  COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME') AS PRODUTO,\\n  SUM(ip.QUANTIDADE) AS QTD_ITENS,\\n  SUM(COALESCE(ip.VALORTOTAL, CAST(ip.QUANTIDADE * ip.VALORUNITARIO AS DECIMAL(16,4)))) AS RECEITA\\nFROM ITENSPEDIDO ip\\nINNER JOIN PEDIDOS p ON p.CODIGO = ip.CODIGOPEDIDO\\nLEFT JOIN PRODUTOS pr ON pr.CODIGO = ip.CODIGOPRODUTO\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND ip.DATADELETE IS NULL\\n\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\n\\n\\n  AND COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME') NOT IN (\\n    'PIZZA GRANDE - 2 Sabores',\\n    'PIZZA GRANDE',\\n    'PIZZA BROTO',\\n    'PIZZA BROTO - 2Sabores'\\n  )\\n\\nGROUP BY COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME')\\nORDER BY RECEITA DESC, QTD_ITENS DESC\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
