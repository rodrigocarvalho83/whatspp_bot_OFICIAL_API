            "data": "{\"sql\": \"SELECT\\n  COALESCE(prm.NOME, 'SEM PROMOÇÃO') AS PROMOCAO,\\n  SUM(ip.QUANTIDADE) AS ITENS_PROMOCIONAIS,\\n  COUNT(DISTINCT p.CODIGO) AS PEDIDOS_COM_PROMO,\\n  SUM(COALESCE(ip.VALORTOTAL, CAST(ip.QUANTIDADE * ip.VALORUNITARIO AS DECIMAL(16,4)))) AS FATURAMENTO_PROMO\\nFROM ITEMPEDIDOPROMOCAO ipp\\nINNER JOIN PROMOCAO prm ON prm.CODIGO = ipp.CODIGOPROMOCAO\\nINNER JOIN ITENSPEDIDO ip ON ip.CODIGO = ipp.CODIGOPROITEMPEDIDO\\nINNER JOIN PEDIDOS p ON p.CODIGO = ip.CODIGOPEDIDO\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND ip.DATADELETE IS NULL\\n\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\n\\nGROUP BY COALESCE(prm.NOME, 'SEM PROMOÇÃO')\\nORDER BY FATURAMENTO_PROMO DESC, ITENS_PROMOCIONAIS DESC\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
