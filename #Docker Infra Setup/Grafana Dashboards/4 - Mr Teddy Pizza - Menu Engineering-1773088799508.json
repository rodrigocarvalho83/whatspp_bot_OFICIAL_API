          "parser": "backend",
          "refId": "A",
          "root_selector": "rows",
          "source": "url",
          "type": "json",
          "url": "https://vm-api.mrteddypizza.com.br/query/select",
          "url_options": {
            "body_content_type": "application/json",
            "body_type": "raw",
            "data": "{\"sql\": \"\\nSELECT\\nCOALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME') AS PRODUTO,\\nSUM(ip.QUANTIDADE) AS QTD,\\nSUM(ip.VALORTOTAL) AS FATURAMENTO,\\nSUM(ip.PRECOCUSTO * ip.QUANTIDADE) AS CUSTO_TOTAL,\\nSUM((ip.VALORUNITARIO - ip.PRECOCUSTO) * ip.QUANTIDADE) AS LUCRO,\\nAVG((ip.VALORUNITARIO - ip.PRECOCUSTO) / NULLIF(ip.VALORUNITARIO,0)) AS MARGEM\\nFROM ITENSPEDIDO ip\\nJOIN PEDIDOS p ON p.CODIGO = ip.CODIGOPEDIDO\\nLEFT JOIN PRODUTOS pr ON pr.CODIGO = ip.CODIGOPRODUTO\\nWHERE p.DATADELETE IS NULL\\nAND p.DATAFECHAMENTO IS NOT NULL\\nAND ip.DATADELETE IS NULL\\n\\nAND COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME') NOT IN (\\n'PIZZA GRANDE - 2 Sabores',\\n'PIZZA GRANDE',\\n'PIZZA BROTO',\\n'PIZZA BROTO - 2Sabores',\\n'PIZZA BROTO - 2 Sabores',\\n'BORDA TRADICIONAL',\\n'PIZZA GRANDE - 3 Sabores',\\n'TERÇA EM DOBRO'\\n)\\n\\nAND p.DATAFECHAMENTO >= ?\\nAND p.DATAFECHAMENTO < ?\\nGROUP BY COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME')\\nORDER BY QTD DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST"
          }
        }
      ],
      "title": "Menu Engineering Base",
      "type": "table"
    }
