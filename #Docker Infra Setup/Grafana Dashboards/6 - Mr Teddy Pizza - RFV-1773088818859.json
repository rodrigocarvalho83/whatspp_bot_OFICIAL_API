            "data": "{\"sql\": \"\\nWITH BASE AS (\\n  SELECT\\n    p.CODIGOCONTATOCLIENTE AS CODIGOCLIENTE,\\n    MAX(p.DATAFECHAMENTO) AS ULTIMA_COMPRA,\\n    COUNT(*) AS FREQUENCIA,\\n    SUM(p.VALORTOTAL - p.VALORENTREGA) AS VALOR_TOTAL\\n  FROM PEDIDOS p\\n  WHERE p.DATADELETE IS NULL\\n    AND p.DATAFECHAMENTO IS NOT NULL\\n    AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\n    AND p.DATAFECHAMENTO < ?\\n  GROUP BY p.CODIGOCONTATOCLIENTE\\n),\\nRFV AS (\\n  SELECT\\n    b.CODIGOCLIENTE,\\n    b.ULTIMA_COMPRA,\\n    DATEDIFF(DAY, b.ULTIMA_COMPRA, ?) AS RECENCIA_DIAS,\\n    b.FREQUENCIA,\\n    b.VALOR_TOTAL,\\n    NTILE(5) OVER (ORDER BY DATEDIFF(DAY, b.ULTIMA_COMPRA, ?) DESC) AS R_SCORE,\\n    NTILE(5) OVER (ORDER BY b.FREQUENCIA ASC) AS F_SCORE,\\n    NTILE(5) OVER (ORDER BY b.VALOR_TOTAL ASC) AS V_SCORE\\n  FROM BASE b\\n)\\n\\nSELECT\\n  CASE\\n    WHEN R_SCORE >= 4 AND F_SCORE >= 4 AND V_SCORE >= 4 THEN 'Campeões'\\n    WHEN R_SCORE >= 4 AND F_SCORE >= 3 THEN 'Leais'\\n    WHEN R_SCORE >= 4 AND F_SCORE <= 2 AND V_SCORE <= 3 THEN 'Promissores'\\n    WHEN R_SCORE = 3 AND F_SCORE >= 3 THEN 'Precisam atenção'\\n    WHEN R_SCORE <= 2 AND F_SCORE >= 3 THEN 'Em risco'\\n    WHEN R_SCORE <= 2 AND F_SCORE <= 2 THEN 'Perdidos/Hibernando'\\n    ELSE 'Outros'\\n  END AS SEGMENTO,\\n  COUNT(*) AS CLIENTES,\\n  AVG(RECENCIA_DIAS) AS RECENCIA_MEDIA_DIAS,\\n  AVG(FREQUENCIA) AS FREQUENCIA_MEDIA,\\n  SUM(VALOR_TOTAL) AS RECEITA_TOTAL,\\n  AVG(VALOR_TOTAL) AS RECEITA_MEDIA_CLIENTE\\nFROM RFV\\nGROUP BY 1\\nORDER BY RECEITA_TOTAL DESC\\n\", \"params\": [\"${__to:date:iso}\", \"${__to:date:iso}\", \"${__to:date:iso}\"]}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST"
          }
        }
