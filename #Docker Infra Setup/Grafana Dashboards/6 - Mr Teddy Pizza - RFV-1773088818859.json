          "parser": "backend",
          "refId": "A",
          "root_selector": "rows",
          "source": "url",
          "type": "json",
          "url": "https://vm-api.mrteddypizza.com.br/query/select",
          "url_options": {
            "body_content_type": "application/json",
            "body_type": "raw",
            "data": "{\"sql\": \"\\nWITH RECURSIVE MESES AS (\\n  SELECT DATEADD(-11 MONTH TO CURRENT_DATE) AS MES\\n  FROM RDB$DATABASE\\n  UNION ALL\\n  SELECT DATEADD(1 MONTH TO MES)\\n  FROM MESES\\n  WHERE MES < CURRENT_DATE\\n),\\nBASE AS (\\n  SELECT\\n    m.MES,\\n    p.CODIGOCONTATOCLIENTE AS CLIENTE,\\n    MAX(p.DATAFECHAMENTO) AS ULTIMA_COMPRA,\\n    COUNT(*) AS FREQUENCIA,\\n    SUM(p.VALORTOTAL - p.VALORENTREGA) AS VALOR_TOTAL\\n  FROM MESES m\\n  JOIN PEDIDOS p\\n    ON p.DATAFECHAMENTO < DATEADD(1 MONTH TO m.MES)\\n   AND p.DATADELETE IS NULL\\n   AND p.DATAFECHAMENTO IS NOT NULL\\n   AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\n  GROUP BY m.MES, p.CODIGOCONTATOCLIENTE\\n),\\nRFV AS (\\n  SELECT\\n    MES,\\n    CLIENTE,\\n    NTILE(5) OVER (PARTITION BY MES ORDER BY DATEDIFF(DAY, ULTIMA_COMPRA, MES) DESC) AS R,\\n    NTILE(5) OVER (PARTITION BY MES ORDER BY FREQUENCIA ASC) AS F,\\n    NTILE(5) OVER (PARTITION BY MES ORDER BY VALOR_TOTAL ASC) AS V\\n  FROM BASE\\n)\\nSELECT\\n  MES,\\n  SUM(CASE WHEN R >= 4 AND F >= 4 AND V >= 4 THEN 1 ELSE 0 END) AS CAMPEOES,\\n  SUM(CASE WHEN R >= 4 AND F >= 3 THEN 1 ELSE 0 END) AS LEAIS,\\n  SUM(CASE WHEN R >= 4 AND F <= 2 THEN 1 ELSE 0 END) AS PROMISSORES,\\n  SUM(CASE WHEN R <= 2 AND F >= 3 THEN 1 ELSE 0 END) AS EM_RISCO,\\n  SUM(CASE WHEN R <= 2 AND F <= 2 THEN 1 ELSE 0 END) AS PERDIDOS\\nFROM RFV\\nGROUP BY MES\\nORDER BY MES\\n\", \"params\": []}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST"
          }
        }
      ],
      "title": "Evolução Mensal RFV (stacked-ready)",
      "type": "barchart"
    },
