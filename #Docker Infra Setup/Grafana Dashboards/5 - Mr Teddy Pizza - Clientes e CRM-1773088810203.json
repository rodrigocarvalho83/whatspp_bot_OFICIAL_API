            "data": "{\"sql\": \"\\nSELECT\\n  COALESCE(d.BAIRRO, c.BAIRRO, 'SEM BAIRRO') AS BAIRRO,\\n  COUNT(DISTINCT p.CODIGOCONTATOCLIENTE) AS CLIENTES,\\n  COUNT(p.CODIGO) AS PEDIDOS,\\n  SUM(p.VALORTOTAL - p.VALORENTREGA) AS RECEITA_PIZZARIA\\nFROM PEDIDOS p\\nINNER JOIN CONTATOS c ON c.CODIGO = p.CODIGOCONTATOCLIENTE\\nLEFT JOIN DELIVERY d ON d.CODIGOPEDIDO = p.CODIGO\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\n\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\n\\nGROUP BY COALESCE(d.BAIRRO, c.BAIRRO, 'SEM BAIRRO')\\nORDER BY RECEITA_PIZZARIA DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
