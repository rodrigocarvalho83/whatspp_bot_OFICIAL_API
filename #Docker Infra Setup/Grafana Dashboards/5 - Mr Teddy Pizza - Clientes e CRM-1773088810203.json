            "data": "{\"sql\": \"\\nSELECT FIRST 50\\n  c.CODIGO,\\n  c.NOME,\\n  c.FONEPRINCIPAL,\\n  MIN(p.DATAFECHAMENTO) AS PRIMEIRA_COMPRA,\\n  COUNT(p.CODIGO) AS PEDIDOS_NO_PERIODO,\\n  SUM(p.VALORTOTAL - p.VALORENTREGA) AS RECEITA_NO_PERIODO\\nFROM PEDIDOS p\\nINNER JOIN CONTATOS c ON c.CODIGO = p.CODIGOCONTATOCLIENTE\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\n\\n  AND p.DATAFECHAMENTO >= ?\\n  AND p.DATAFECHAMENTO < ?\\n\\nGROUP BY c.CODIGO, c.NOME, c.FONEPRINCIPAL\\nHAVING MIN(p.DATAFECHAMENTO) >= ?\\n   AND MIN(p.DATAFECHAMENTO) < ?\\nORDER BY RECEITA_NO_PERIODO DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\", \"${__from:date:iso}\", \"${__to:date:iso}\"]}",
