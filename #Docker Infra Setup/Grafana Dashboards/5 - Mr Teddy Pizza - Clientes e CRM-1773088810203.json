            "data": "{\"sql\": \"\\nSELECT FIRST 50\\n  c.CODIGO,\\n  c.NOME,\\n  c.FONEPRINCIPAL,\\n  MAX(p.DATAFECHAMENTO) AS ULTIMA_COMPRA,\\n  COUNT(p.CODIGO) AS PEDIDOS_HISTORICOS,\\n  SUM(p.VALORTOTAL - p.VALORENTREGA) AS RECEITA_HISTORICA\\nFROM PEDIDOS p\\nINNER JOIN CONTATOS c ON c.CODIGO = p.CODIGOCONTATOCLIENTE\\nWHERE p.DATADELETE IS NULL\\n  AND p.DATAFECHAMENTO IS NOT NULL\\n  AND p.CODIGOCONTATOCLIENTE IS NOT NULL\\nGROUP BY c.CODIGO, c.NOME, c.FONEPRINCIPAL\\nHAVING MAX(p.DATAFECHAMENTO) < CURRENT_DATE - 90\\nORDER BY ULTIMA_COMPRA DESC\\n\", \"params\": []}",
