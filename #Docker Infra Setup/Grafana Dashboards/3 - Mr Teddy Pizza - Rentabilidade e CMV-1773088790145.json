          "url": "https://vm-api.mrteddypizza.com.br/query/select",
          "url_options": {
            "body_content_type": "application/json",
            "body_type": "raw",
            "data": "{\"sql\": \"\\nSELECT\\n  COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME') AS PRODUTO,\\n  SUM(ip.QUANTIDADE) AS QTD,\\n  SUM((ip.VALORUNITARIO - ip.PRECOCUSTO) * ip.QUANTIDADE) AS LUCRO,\\n  SUM(COALESCE(ip.VALORTOTAL, CAST(ip.QUANTIDADE * ip.VALORUNITARIO AS DECIMAL(16,4)))) AS FATURAMENTO,\\n  SUM(ip.PRECOCUSTO * ip.QUANTIDADE) AS CUSTO_TOTAL\\nFROM ITENSPEDIDO ip\\nJOIN PEDIDOS p ON p.CODIGO = ip.CODIGOPEDIDO\\nLEFT JOIN PRODUTOS pr ON pr.CODIGO = ip.CODIGOPRODUTO\\nWHERE p.DATADELETE IS NULL\\nAND p.DATAFECHAMENTO IS NOT NULL\\nAND ip.DATADELETE IS NULL\\nAND COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME') NOT IN (\\n'PIZZA GRANDE - 2 Sabores',\\n'PIZZA GRANDE',\\n'PIZZA BROTO',\\n'PIZZA BROTO - 2Sabores',\\n'PIZZA BROTO - 2 Sabores',\\n'BORDA TRADICIONAL',\\n'PIZZA GRANDE - 3 Sabores',\\n'TERÇA EM DOBRO'\\n)\\nAND p.DATAFECHAMENTO >= ?\\nAND p.DATAFECHAMENTO < ?\\nGROUP BY COALESCE(pr.NOME, ip.NOMEPRODUTO, 'SEM NOME')\\nORDER BY LUCRO DESC\\n\", \"params\": [\"${__from:date:iso}\", \"${__to:date:iso}\"]}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST"
          }
        }
